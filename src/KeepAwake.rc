#include <winres.h>
#include "resource.h"

IDI_KEEPAWAKE_ON  ICON "icons/KeepAwake-On.ico"
IDI_KEEPAWAKE_OFF ICON "icons/KeepAwake-Off.ico"
IDI_KEEPAWAKE_ON_DISPLAY ICON "icons/KeepAwake-OnDisplay.ico"
IDI_KEEPAWAKE_SMILE ICON "icons/KeepAwake-Smile.ico"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "KeepAwake.manifest"

// Окно выбора времени. Тексты подставляет программа на языке интерфейса.
// Стили счётчика: UDS_ALIGNRIGHT (0x04) | UDS_AUTOBUDDY (0x10) | UDS_ARROWKEYS (0x20).
IDD_TIME_PICKER DIALOGEX 0, 0, 170, 62
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_TOPMOST
CAPTION "KeepAwake"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_TIME_LABEL, 10, 13, 90, 10
    EDITTEXT        IDC_TIME_VALUE, 104, 10, 44, 14, ES_CENTER | ES_READONLY
    CONTROL         "", IDC_TIME_SPIN, "msctls_updown32", 0x34, 148, 10, 10, 14
    DEFPUSHBUTTON   "OK", IDOK, 56, 38, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 110, 38, 50, 14
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    KA_VERSION_MAJOR, KA_VERSION_MINOR, KA_VERSION_PATCH, 0
 PRODUCTVERSION KA_VERSION_MAJOR, KA_VERSION_MINOR, KA_VERSION_PATCH, 0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription",  "KeepAwake"
            VALUE "FileVersion",      KA_VERSION_STRING
            VALUE "InternalName",     "KeepAwake"
            VALUE "OriginalFilename", "KeepAwake.exe"
            VALUE "ProductName",      "KeepAwake"
            VALUE "ProductVersion",   KA_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
