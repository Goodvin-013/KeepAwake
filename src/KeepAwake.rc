#include <winres.h>
#include "resource.h"

IDI_KEEPAWAKE_ON  ICON "icons/KeepAwake-On.ico"
IDI_KEEPAWAKE_OFF ICON "icons/KeepAwake-Off.ico"
IDI_KEEPAWAKE_ON_DISPLAY ICON "icons/KeepAwake-OnDisplay.ico"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "KeepAwake.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    KA_VERSION_MAJOR, KA_VERSION_MINOR, KA_VERSION_PATCH, 0
 PRODUCTVERSION KA_VERSION_MAJOR, KA_VERSION_MINOR, KA_VERSION_PATCH, 0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription",  "KeepAwake"
            VALUE "FileVersion",      KA_VERSION_STRING
            VALUE "InternalName",     "KeepAwake"
            VALUE "OriginalFilename", "KeepAwake.exe"
            VALUE "ProductName",      "KeepAwake"
            VALUE "ProductVersion",   KA_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
